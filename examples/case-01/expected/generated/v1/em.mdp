; generated by md-repro-checker: stage=em
; 逐参数来源见同目录 provenance.json

integrator              = steep
emtol                   = 1000.0
emstep                  = 0.01
nsteps                  = 50000

cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
DispCorr                = EnerPres

constraints             = h-bonds
constraint-algorithm    = LINCS
lincs-order             = 4
lincs-iter              = 1

tcoupl                  = berendsen
tau-t                   = 0.1
ref-t                   = 300

pcoupl                  = no

