# generated by md-repro-checker: stage=prod
# 逐参数来源见同目录 provenance.json 的 lammps 段

units           real
# units real: 距离 A / 时间 fs / 能量 kcal/mol / 温度 K / 压强 atm
atom_style      full
# full: 带电荷与分子 ID；聚合物/生物体系的标准选择
boundary        p p p

# 力场: GAFF2   [paper]
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  cvff
special_bonds   amber
# AMBER/GAFF 约定：1-4 库仑缩放 5/6，1-4 LJ 缩放 1/2；此值由力场决定，所有阶段必须一致
include         TODO.forcefield
# ↑ 须含 pair_coeff / bond_coeff / angle_coeff / dihedral_coeff / improper_coeff
#   LAMMPS 不读取力场库；用 fftool / msi2lmp / Moltemplate / 自备参数文件生成

# 初始结构: Packmol   [paper]
read_data       TODO.data

pair_style      lj/cut/coul/long 10.0
kspace_style    pppm 1.0e-4
# !! PME 必须成对出现：pair_style 用 coul/long + kspace_style pppm。
#    写成 lj/cut/coul/cut 且不给 kspace_style 时，LAMMPS 不会报错，
#    只是静默退化为纯截断库仑：结果与原文不可比。
pair_modify     tail yes
pair_modify     mix arithmetic
# AMBER/GAFF 用 Lorentz-Berthelot：ε 几何平均、σ 算术平均
# LAMMPS 默认是 geometric；漏写不报错，只让所有 I≠J 交叉对的 σ 偏移

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        2
# units real 下 timestep 单位为 fs，与文献报告单位一致
variable        seed equal 12345
# 固定随机种子：换种子须重跑并重新记录，否则轨迹不可复现

# ======================================================================
# 热输运：Direct NEMD   [paper]
# ======================================================================
# 冷热浴 350 K / 250 K，ΔT/T_avg = 33.3%
# !! 温差已超过平均温度的 10%，可能偏离线性响应区：
#    此时 κ 依赖于 ΔT 本身，不再是材料常数。
#    验证方式：做 ΔT 扫描（如 0.5ΔT / 1.0ΔT / 1.5ΔT），
#    确认 κ 不随 ΔT 变；否则须减小 ΔT 重跑。

# 直接 NEMD：两端设固定壁，紧邻固定壁设冷/热浴，
# 中间为 NVE 区，在**盒子中央**测量热流（避开恒温浴的扰动）。

# 几何：温度梯度沿 x。区域厚度必须取梯度方向的长度 Lx，
# 取 Lz 会让切片厚度错误：脚本照常运行，梯度却是错的。
variable        Lx equal (xhi-xlo)
variable        w_wall  equal 0.05*${Lx}
variable        w_bath  equal 0.10*${Lx}
variable        w_slab  equal 0.10*${Lx}

variable        wallL_lo equal xlo
variable        wallL_hi equal xlo+${w_wall}
variable        bathH_lo equal ${wallL_hi}
variable        bathH_hi equal ${bathH_lo}+${w_bath}
variable        wallR_hi equal xhi
variable        wallR_lo equal xhi-${w_wall}
variable        bathC_hi equal ${wallR_lo}
variable        bathC_lo equal ${bathC_hi}-${w_bath}
variable        slab_c   equal (xlo+xhi)/2.0
variable        slab_lo  equal ${slab_c}-${w_slab}/2.0
variable        slab_hi  equal ${slab_c}+${w_slab}/2.0

#   units box 必须显式写出：region 默认按 lattice 单位解释边界，
#   而 read_data 读入的体系没有 lattice 定义。
region          wallL block ${wallL_lo} ${wallL_hi} INF INF INF INF units box
region          bathH block ${bathH_lo} ${bathH_hi} INF INF INF INF units box
region          bathC block ${bathC_lo} ${bathC_hi} INF INF INF INF units box
region          wallR block ${wallR_lo} ${wallR_hi} INF INF INF INF units box
region          slab  block ${slab_lo}  ${slab_hi}  INF INF INF INF units box

group           wallL region wallL
group           bathH region bathH
group           bathC region bathC
group           wallR region wallR
group           slab  region slab

variable        T_src equal 350
variable        T_snk equal 250
variable        Tdamp equal 100.0    # 单位 fs

compute         TbathH all temp/region bathH
compute         TbathC all temp/region bathC

fix             fH bathH langevin ${T_src} ${T_src} ${Tdamp} ${seed}
fix             fC bathC langevin ${T_snk} ${T_snk} ${Tdamp} ${seed}
fix_modify      fH temp TbathH
fix_modify      fC temp TbathC
#   ↑↑ 恒温 fix 的 group 必须是 bathH / bathC，**不能写 all**。
#      fix langevin 的受力范围由 fix 自己的 group 决定
#      （源码 fix_langevin.cpp 的 `if (mask[i] & groupbit)`），
#      与 fix_modify temp 指定的 compute 的 group 无关。
#      两个恒温器都写 all 时，全体原子被两个不同温度的浴同时
#      作用，温度梯度被抹平：脚本正常运行，κ 无意义。

# 两端固定壁：冻结受力，并清零初速度
fix             freezeL wallL setforce 0.0 0.0 0.0
fix             freezeR wallR setforce 0.0 0.0 0.0
velocity        wallL set 0.0 0.0 0.0
velocity        wallR set 0.0 0.0 0.0

# 中间区域 NVE：热流必须在一段能量守恒的区域里测量
group           mobile subtract all wallL wallR
fix             nve_mobile mobile nve

# 热流：只在中央测量组上计算
compute         ke_atom   slab ke/atom
compute         pe_atom   slab pe/atom
compute         strs_atom slab centroid/stress/atom NULL virial
#   ↑ 见 Green-Kubo 段的说明：手册明确推荐 centroid/stress/atom
compute         jflux   slab heat/flux ke_atom pe_atom strs_atom

# 归一化体积 = **测量组所在**的体积 = Ly * Lz * 切片厚度。
#   heat/flux 返回的是 extensive 值（energy*velocity），
#   手册要求除以「包含该 group 原子的体积」：
#   group 是中央切片时用整盒体积会算错，且不报错。
variable        V_slab equal (yhi-ylo)*(zhi-zlo)*v_w_slab
variable        J_slab equal c_jflux[1]/v_V_slab

fix             flx_avg slab ave/time 10 100 1000 v_J_slab ave one &
                file flux.profile
compute         layers all chunk/atom bin/1d x lower 0.5 units box
fix             tmp_avg all ave/chunk 10 100 1000 layers temp &
                norm sample file temp.profile

# 判据：T(x) 剖面须**线性且单调**（V 形分布的线性拟合 R² 也不低），
# 且 κ 在多个统计窗口内不漂移。见 src/convergence.py。
# ======================================================================

thermo          1000
thermo_style    custom step temp pe ke etotal press vol
thermo_modify   flush yes
run             10000000
# 20.0 ns / 2 fs = 10000000 步

reset_timestep  0
write_data      final.data nocoeff
