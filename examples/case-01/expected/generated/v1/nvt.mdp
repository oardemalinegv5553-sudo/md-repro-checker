; generated by md-repro-checker: stage=nvt
; 逐参数来源见同目录 provenance.json

integrator              = md
dt                      = 0.002
nsteps                  = 10000000

nstxout-compressed      = 5000
nstenergy               = 5000
nstlog                  = 5000
compressed-x-precision  = 1000

cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
DispCorr                = EnerPres

constraints             = h-bonds
constraint-algorithm    = LINCS
lincs-order             = 4
lincs-iter              = 1

tcoupl                  = berendsen
tau-t                   = 0.1
ref-t                   = 300
gen-vel                 = yes
gen-temp                = 300
gen-seed                = -1

pcoupl                  = Parrinello-Rahman
tau-p                   = 2.0
pcoupltype              = isotropic
compressibility         = 4.5e-5
ref-p                   = 1.0

